# COPY into a local .env file. Never commit your actual keys or token.
# Node does not read .env automatically: use node --env-file=.env server.js
PORT=8787
HOST=127.0.0.1
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERATOR_TOKEN=CHANGE_TO_RANDOM_64_CHAR_HEX
TRADING_MODE=paper
# paper | testnet | live
LIVE_TRADING_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
MAX_ORDER_USDT=25
MAX_DAILY_NOTIONAL_USDT=50
MAX_ESTIMATED_RISK_USDT=0.75
MAX_ORDERS_PER_DAY=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
